---
import BaseLayout from "./BaseLayout.astro";
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <main class="flex items-center justify-content-center h-screen">
    <div
      class="flex flex-col items-center relative gap-10 justify-center bg-linear-to-bl from-(--color-bg-dark)/25 to-(--color-bg-end) h-full w-full lg:w-3/5">
      <h1 class="text-orange-500 text-3xl md:text-6xl font-bold">
        Bienvenid@ de nuevo!
      </h1>
      <article
        class="bg-white/10 backdrop-blur-lg border border-white/50 p-5 max-w-5/6 md:p-10 md:w-3/5 h-3/6 rounded-sm -200 shadow-xl shadow-gray-500/50">
        <slot />
      </article>
    </div>

    <img
      src="/src/assets/bg-login.jpg"
      alt="bicicletas"
      class="hidden lg:block w-2/5 h-full bg-contain overflow-hidden"
    />
  </main>
</BaseLayout>

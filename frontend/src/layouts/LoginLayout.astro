---
import BaseLayout from "./BaseLayout.astro";
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <main class="flex items-center justify-content-center h-screen">
    <div
      class="flex flex-col items-center relative gap-3 justify-center bg-radial-[at_10%_10%] from-purple-500 to-indigo-300 to-75% h-full w-full lg:w-1/2">
      <h1 class="text-white text-6xl font-bold">Login</h1>
      <article
        class="bg-(--color-card) p-10 w-3/6 h-3/6 rounded-sm -200 shadow-xl shadow-indigo-600/50">
        <slot />
      </article>
    </div>

    <div class=""></div>
  </main>
</BaseLayout>

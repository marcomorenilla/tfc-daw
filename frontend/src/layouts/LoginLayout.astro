---
import BaseLayout from "./BaseLayout.astro";
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <main
    class="flex items-center justify-content-center h-auto pt-5 pb-5 bg-linear-to-br from-amber-50 via-amber-100 to-amber-50">
    <div
      class="flex flex-col items-center relative gap-5 justify-center w-full lg:w-3/5">
      <h1
        class="text-teal-600 text-3xl md:text-5xl font-extrabold tracking-tight">
        Bienvenid@ de nuevo
      </h1>
      <article
        class="bg-white p-8 max-w-full md:p-12 md:w-4/5 lg:w-3/4 rounded-2xl shadow-lg border border-gray-100">
        <slot />
      </article>
    </div>

    <img
      src="/src/assets/bicis.jpg"
      alt="bicicleta moderna"
      class="hidden lg:block w-2/5 h-screen object-cover overflow-hidden"
    />
  </main>
</BaseLayout>

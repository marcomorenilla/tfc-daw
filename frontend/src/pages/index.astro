---
import IndexGrid from "@/components/index/IndexGrid";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { getBikes } from "@/services/bikesApi";

const bikes = await getBikes();

const sortedIndexBikes = bikes
  .sort((a: any, b: any) => b.rate - a.rate)
  .slice(0, 6);
---

<IndexLayout title="Inicio">
  <IndexGrid bikes={sortedIndexBikes} client:load />
</IndexLayout>

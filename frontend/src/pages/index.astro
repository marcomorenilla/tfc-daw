---
import BikeGrid from "@/components/bikes/BikeGrid";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { getBikes } from "@/services/bikesApi";

const bikes = await getBikes();

const sortedIndexBikes = bikes
  .sort((a: any, b: any) => b.rate - a.rate)
  .slice(0, 6);
---

<IndexLayout title="Inicio">
  <BikeGrid bikes={sortedIndexBikes} client:load />
</IndexLayout>
